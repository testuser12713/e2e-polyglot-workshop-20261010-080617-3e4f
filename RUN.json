{
  "runcontract": 1,
  "services": [
    {
      "name": "db",
      "kind": "database",
      "engine": "postgres"
    },
    {
      "name": "queue",
      "kind": "database",
      "engine": "valkey"
    },
    {
      "name": "worker",
      "dir": "worker",
      "stack": "python",
      "kind": "worker",
      "install": [
        ["${python}", "-m", "pip", "install", "-q", "-e", "."],
        ["${python}", "-m", "pip", "install", "-q", "pytest>=8"]
      ],
      "test": [["${python}", "-m", "pytest", "-q"]],
      "start": ["${python}", "-m", "worker.main"],
      "ready_log": "worker ready",
      "depends_on": ["db", "queue"],
      "env": {
        "DATABASE_URL": { "dev": "${service:db.url}" },
        "VALKEY_URL": { "dev": "${service:queue.url}" },
        "HOURLY_RATE_CENTS": { "dev": "8000" },
        "VAT_PERCENT": { "dev": "19" },
        "INVOICE_QUEUE_KEY": {
          "dev": "invoices",
          "not_secret": true,
          "why": "name of the Valkey list the invoice jobs are queued on, not a credential"
        }
      }
    }
  ]
}
